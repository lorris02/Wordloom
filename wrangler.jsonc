{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordloom",
  "main": ".deploy/worker.mjs",
  "build": {"command": "node scripts/build-worker.mjs"},
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
