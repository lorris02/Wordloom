{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordloom",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "none"
  },
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
