# Optional: enables AI sentence feedback on a Node hosting service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4173

# Optional: enables email/password accounts and cloud sync.
DATABASE_URL=mysql://user:password@host:3306/database
DATABASE_CA=
APP_ORIGIN=http://localhost:4173
PASSWORD_PEPPER=replace-with-a-random-secret-at-least-32-characters

# Optional password reset email delivery (use a verified sender domain).
RESEND_API_KEY=
EMAIL_FROM=

# Optional password reset SMS delivery (E.164 sender number).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
