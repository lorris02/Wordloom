# Optional: enables AI sentence feedback on a Node hosting service.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
PORT=4173

# Optional: enables email/password accounts and cloud sync.
DATABASE_URL=mysql://user:password@host:3306/database
DATABASE_CA=
APP_ORIGIN=http://localhost:4173
PASSWORD_PEPPER=replace-with-a-random-secret-at-least-32-characters
